# Copy to .env and fill in. Never commit .env.

# Your own Flickr API key and secret (https://www.flickr.com/services/apps/create/)
FLICKR_KEY=
FLICKR_SECRET=

# The address you open Albumsmith at, no trailing slash.
# Flickr sends you back to BASE_URL/auth/callback after you authorise.
BASE_URL=http://localhost:8765

# Optional: if empty, a secret is generated and kept in the data volume.
# SESSION_SECRET=

# Optional: use your own first-time setup code instead of a random one.
# SETUP_CODE=

# Behind a reverse proxy? Just use an https:// BASE_URL: secure cookies and
# proxy trust are then enabled automatically.
# Number of proxies in front of Albumsmith (default 1). Only change this
# if there is more than one, for example Cloudflare plus a local proxy.
# TRUST_PROXY=1

# Nightly sync time (24h, server time zone) and time zone.
SYNC_TIME=03:30
TZ=Europe/Stockholm

# Optional push notifications (for example an ntfy topic URL).
# NOTIFY_URL=
# NOTIFY_TOKEN=

# Host port for the web interface (used by docker-compose.yml).
ALBUMSMITH_PORT=8765
